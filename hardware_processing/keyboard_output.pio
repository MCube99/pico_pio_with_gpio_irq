.pio_version 0

.program keyboard_input

keyboard_setup:
    set pindirs, 1
    irq wait 1
    
get_data:    
    pull block
    wait 0 pin 2 ; wait for csn to go low
    out pins, 1 ; outputs a data 

.wrap_target
bitloop:
    wait 1 pin 0
    out pins, 1 ; shift another bit instantly out after waiting
    in pins, 1
    jmp !osre, bitloop
check_keyboard_select:
    jmp pin get_data
.wrap

% c-sdk {
#include "hardware/gpio.h"    
static inline void keyboard_input_program_init(PIO pio, uint sm, uint offset,uint pin_mosi, uint pin_sck, uint pin_miso, uint jmp_pin)
{
    pio_sm_config c = keyboard_input_program_get_default_config(offset);
    /* Configure the PIO state machine */
    sm_config_set_in_pins(&c, pin_mosi);
    sm_config_set_out_pins(&c, pin_miso, 1);
    sm_config_set_set_pins(&c, pin_miso, 1);
    sm_config_set_jmp_pin(&c, pin_csn);
    sm_config_set_out_shift(&c, false, true, 8);

    /* Give the PIO control of the SPI MISO pins */
    pio_gpio_init(pio, pin_miso);

    /* Drive MISO low before enabling the state machine */
    pio_sm_set_pins_with_mask(
        pio,
        sm,
        0,
        1u << pin_miso
    );

    /* Only MISO is driven by the slave. */
    pio_sm_set_pindirs_with_mask(
        pio,
        sm,
        1u << pin_miso,
        (1u << pin_sck) |
        (1u << pin_mosi) |
        (1u << pin_miso) |
        (1u << pin_csn)
    );

    /* Reduce latency on SPI input signals. */
    hw_set_bits(&pio->input_sync_bypass,
                (1u << pin_sck) |
                (1u << pin_mosi));

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
}
%}
