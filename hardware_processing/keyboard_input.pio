.pio_version 0

.program keyboard_input

keyboard_sets:
    set pindirs, 1
    set x, 0
    irq wait 1

keyboard_setup:
    pull ifempty block ;; pull if its empty, blocking while you do so
    jmp !x keyboard_sets
    wait 0 gpio 4 ;; Waits for csn and subsequently and low clock
    out pins, 1  ; immediately after, so that the data is preloaded for the serial clock

.wrap_target
bitloop:
    wait 1 pin 1 ; the master samples and shifts a bit here 
    wait 0 pin 1 ; wait for 0 before loading up next transaction
    out pins, 1
check_chip_select:
    jmp pin keyboard_setup ; if pin goes up then transaction is over, and wait for data.
.wrap


% c-sdk {
static inline void keyboard_input_program_init(PIO pio, uint sm, uint offset, uint data_pin, uint jmp_pin)
{
    pio_sm_config c = keyboard_input_program_get_default_config(offset);

    sm_config_set_out_pins(&c, data_pin, 1);
    sm_config_set_set_pins(&c, data_pin, 1);

    pio_gpio_init(pio, data_pin);
    sm_config_set_jmp_pin(&c, jmp_pin);

    sm_config_set_out_shift(&c, false,false, 8);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}