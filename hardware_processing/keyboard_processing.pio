
.pio_version 0

.program keyboard_processing 
.wrap_target

keyboard_setup:
    irq wait 1
    set y, 7               ; for every clock cycle
    mov x, osr 
    jmp !x get_size_byte; will put in 0 if its an escape character or something, and that will cause it to jump to the top 
    wait 0 gpio 4

keyboard_processing: 
    wait 0 pin 1
    wait 1 pin 1
    out pins, 1
    jmp y-- keyboard_processing

.wrap